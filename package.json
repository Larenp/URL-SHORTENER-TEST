{
  "name": "url-shortener-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant URL shortener and analytics platform",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev:backend": "npm run start:dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "build:backend": "npm run build --workspace backend",
    "build:frontend": "npm run build --workspace frontend",
    "build": "npm run build:backend && npm run build:frontend",
    "seed": "npm run seed --workspace backend",
    "test": "npm run test --workspace backend",
    "lint": "npm run lint --workspace backend && npm run lint --workspace frontend",
    "format": "prettier --write \"{backend,frontend}/src/**/*.{ts,tsx}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  }
}
