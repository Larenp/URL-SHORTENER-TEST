# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=info

# Database (matches docker-compose.yml defaults — no changes needed for local dev)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/url_shortener

# Cache (matches docker-compose.yml defaults — no changes needed for local dev)
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-please-32-chars-min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-please-32-chars-min
JWT_REFRESH_EXPIRES_IN=7d
